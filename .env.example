# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FETCH_TIMEOUT_MS=12000

# Resend (required) — sending domain + inbound MX on mail.pigeonlabs.nyc
RESEND_API_KEY=
# Signing secret of the webhook you create in Resend pointing at /api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Default sender if settings.sender is not set yet
DEFAULT_FROM_EMAIL=daniel@mail.pigeonlabs.nyc

# Hunter.io (email finder + verifier)
HUNTER_API_KEY=

# Novita (only used for natural-language step conditions)
NOVITA_API_KEY=

# Vercel cron -> /api/cron/run-sequences
CRON_SECRET=

# Landing site integration (artoo.love). LEAD_TOKEN_SECRET must match the landing site.
LEAD_TOKEN_SECRET=
LANDING_WEBHOOK_SECRET=
LANDING_BASE_URL=https://www.artoo.love

# Public URL of this deployment (used for unsubscribe links). Falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
